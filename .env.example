# Everything here is local. No cloud model API keys: Hermes supplies the model,
# and Hermes gets its capacity from your own subscription via its configured
# provider (Hermes/this app own the tools).

# --- how we reach Hermes -----------------------------------------------------
# cli  = shell out to the local `hermes` binary   (default, matches Antigravity setup)
# http = local OpenAI-compatible endpoint, if your build exposes one
# mock = fully offline stand-in, spends no quota (use for UI work)
HERMES_TRANSPORT=cli

# -- cli transport  (values below match: Hermes v0.23.1, anthropic/claude_code OAuth)
HERMES_CLI_BIN=hermes
# Leave both EMPTY to use the provider and model from Hermes' own config.yaml
# (verified working: `hermes -z "..."` with no flags). Set them only to override.
HERMES_PROVIDER=
HERMES_MODEL=

# Per-role models. The interview is ONE conversation that decides the whole
# team, so it is worth a capable model. The agents then make many calls each
# and are where the tokens actually go, so they can run somewhere cheap —
# a local Ollama or LM Studio model costs nothing and keeps data on-machine.
#
#   Local Ollama (free):   provider=custom  and set model.base_url in Hermes'
#                          config.yaml to http://127.0.0.1:11434/v1
#   Local LM Studio (free): provider=lmstudio
#
# Example: design on Claude, run the agents locally for free.
#   HERMES_INTERVIEW_MODEL=claude-opus-4-5-20251101
#   HERMES_WORKER_PROVIDER=custom
#   HERMES_WORKER_MODEL=qwen3:8b
HERMES_INTERVIEW_MODEL=
HERMES_INTERVIEW_PROVIDER=

# The interview calls no tools and reads no files, so it does not need Hermes'
# toolsets or skills loaded. Restricting them cuts the startup cost paid on
# every chat turn — the main reason short exchanges feel slow.
# Empty value = no toolsets at all. Set LEAN=0 to restore AGENTS.md/memory
# injection for the interview (slower, but Honcho memory applies).
HERMES_INTERVIEW_TOOLSETS=clarify
# Thinking effort while the Architect is asking questions, and while it is
# designing the team. Asking "what format do you want?" does not need deep
# reasoning; designing a team does. Raise ASK if its questions feel shallow.
HERMES_INTERVIEW_REASONING=low
HERMES_DESIGN_REASONING=high
HERMES_INTERVIEW_LEAN=1
HERMES_WORKER_MODEL=
HERMES_WORKER_PROVIDER=
# Default seconds per Hermes call. Agents can override it with timeout_s in
# their spec; a web-research agent routinely needs several minutes.
HERMES_CLI_TIMEOUT=900
# The non-interactive invocation. MUST NOT open the TUI: `chat -q` does on 0.23.x
# and will hang. {prompt} is substituted; other words pass through verbatim.
HERMES_CLI_ARGS=-z {prompt}

# -- per-user work profiles (the isolation that matters with multiple accounts)
# per_user = each account gets its own Hermes profile: own config, memory,
#            sessions and skills. Created automatically on first use.
# off      = everyone shares one profile (only sensible for a single user).
HERMES_PROFILE_MODE=per_user
HERMES_PROFILE_PREFIX=af
# New profiles are cloned from this one, so they inherit provider auth and
# skills. Set empty for bare profiles (then each needs `hermes auth add`).
HERMES_PROFILE_CLONE_FROM=default
# 1 = sub-agent runs get a separate "-w" profile per user, so machine-written
# delegation text never lands in that user's own memory or user model.
HERMES_WORKER_SUBPROFILE=1

# --- cheap tier: run the mechanical agents on a free local model ------------
# Setting a model here turns the tier on. The Architect then marks each agent
# "cheap" or "capable", and the cheap ones run on this model: free, on-machine,
# no quota. A "-wc" profile is created and configured automatically on first
# use (Hermes reads base_url from a profile, not from a flag).
# A leader that delegates is never allowed to run cheap.
#   ollama list   shows what you have pulled
HERMES_CHEAP_MODEL=qwen3:4b
HERMES_CHEAP_PROVIDER=ollama
HERMES_CHEAP_BASE_URL=http://127.0.0.1:11434/v1

# -- static profile override (ignored when HERMES_PROFILE_MODE=per_user)
HERMES_PROFILE=
HERMES_WORKER_PROFILE=

# -- hermes proxy: a persistent server for the interview only
# Measured on this machine: a CLI call costs ~15s of process start before the
# model is reached — over half of every interview turn. `hermes proxy start`
# keeps one process alive and answers over HTTP instead.
# Only the interview uses it: workers need Hermes to run their tools, enforce
# their toolset grants and load their AGENTS.md, none of which a raw inference
# proxy does. If the proxy is down the interview silently uses the CLI.
# NOTE: `hermes proxy` only forwards to nous or xai — it cannot serve an
# Anthropic/claude_code login. Any OpenAI-compatible server works here though,
# and Ollama already is one, with nothing to start:
#   HERMES_PROXY_BASE_URL=http://127.0.0.1:11434
#   HERMES_PROXY_MODEL=gpt-oss:120b-cloud     (capable, runs on Ollama's side)
#   HERMES_PROXY_MODEL=qwen3:4b               (local and free, but slow on CPU)
# Leave blank to keep the interview on the CLI.
HERMES_PROXY_BASE_URL=
HERMES_PROXY_MODEL=
HERMES_PROXY_API_KEY=local

# -- http transport
HERMES_BASE_URL=http://127.0.0.1:1234
HERMES_API_KEY=

# --- quota protection --------------------------------------------------------
# Hard cap on model calls per team run, so one bad loop can't drain your
# Antigravity weekly quota. 0 disables the cap.
AGENTFORGE_MAX_MODEL_CALLS_PER_RUN=25
# Wall-clock budget for a whole run. A hierarchy multiplies calls — a
# supervisor turn delegates to a manager, which takes its own turns, each
# spawning a worker — so a team can grind for many minutes while every single
# call stays inside its own timeout. 0 = no limit.
AGENTFORGE_RUN_DEADLINE_S=900

# --- fallbacks (keep the page usable while wiring things up) -----------------
AGENTFORGE_FALLBACK_MOCK=1

# --- tool credentials --------------------------------------------------------
# Leave empty to stay fully local. web_search uses Serper (a cloud call) only if
# this is set; for a local-only search tool, run SearXNG and use SEARX_BASE_URL.
SERPER_API_KEY=
SEARX_BASE_URL=

# --- where created agents are written ----------------------------------------
# Role 2 writes one folder per agent here, each with its own AGENTS.md that
# Hermes loads via --in. Edit those files directly any time.
AGENTFORGE_TEAMS_DIR=./teams

# --- Hermes toolsets and skills the Architect may grant ----------------------
# Paste from `hermes tools` and `hermes skills list`. Leaving these empty means
# the Architect works from a stock-install guess and cannot grant your skills.
HERMES_TOOLSETS=
HERMES_SKILLS=

# --- accounts ----------------------------------------------------------------
# Where the machine-local server key lives (created on first run, 0600).
# Passwords are NEVER stored here or anywhere else — only scrypt hashes, in the
# database. Back this folder up if you want existing logins to survive a move.
AGENTFORGE_SECRETS_DIR=./.secrets
AGENTFORGE_SESSION_TTL_DAYS=30
# Set to 1 only when serving over HTTPS (cookie becomes HTTPS-only).
AGENTFORGE_COOKIE_SECURE=0
# Browser origins allowed to call the API. Keep this tight: the session cookie
# is sent with requests, so a wildcard would let any page act as the user.
AGENTFORGE_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Multica mirror (admin tracking in Multica's own UI) ---------------------
# The Admin tab in this app always works and needs none of this. The mirror
# ALSO pushes each team and each run into Multica as an issue, so an admin can
# watch them there. Sub-agents are deliberately NOT created as Multica agents:
# that would hand execution to Multica's daemon alongside Hermes.
#
# Your Multica profile points at Multica Cloud, so with the mirror ON, team
# names, user prompts and agent output leave this machine. Set 0 to stop that.
MULTICA_MIRROR=1
MULTICA_CLI_BIN=C:\Users\ZEINA TAHA\AppData\Local\Programs\@multicadesktop\resources\app.asar.unpacked\resources\bin\multica.exe
# The desktop app keeps its config under this profile, not the CLI default.
MULTICA_PROFILE=desktop-api.multica.ai
# Workspace "Metis"
MULTICA_WORKSPACE_ID=7e87cbf8
# Optional: group every mirrored issue under one project (multica project list)
MULTICA_PROJECT_ID=
MULTICA_TIMEOUT=90
MULTICA_MAX_BODY_CHARS=8000
# Description files are staged in the system temp directory by default, not in
# this project folder: inside OneDrive, deletion is unreliable and files holding
# user prompts and agent output linger in a synced folder. Set to 1 only if you
# want them staged in ./.multica-outbox instead.
MULTICA_OUTBOX_IN_CWD=0
